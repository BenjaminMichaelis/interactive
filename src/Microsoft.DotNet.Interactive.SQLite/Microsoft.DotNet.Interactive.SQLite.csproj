<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageDescription>Microsoft SQLite support for .NET Interactive</PackageDescription>
    <PackageTags>polyglot notebook dotnet interactive SQL SQLite Data</PackageTags>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5100;VSTHRD002</NoWarn>
    <!-- dll outside of lib/ folder -->
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Keep the net10.0 asset on the Microsoft.Data.Sqlite 10.x line (and the SQLitePCLRaw 2.x dependency floor it implies). -->
    <PackageReference Include="Microsoft.Data.Sqlite" VersionOverride="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Data.Sqlite" Condition="'$(TargetFramework)' != 'net10.0'" />
    <PackageReference Include="Pocket.Disposable">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PocketLogger">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.DotNet.Interactive\Microsoft.DotNet.Interactive.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="extension.dib" Pack="true" PackagePath="interactive-extensions/dotnet" />
  </ItemGroup>

</Project>
